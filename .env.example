# Google Apps Script Web App URL that appends signups to a Google Sheet.
# See CLAUDE.md for the manual setup steps. Server-only — never exposed to the client.
GOOGLE_APPS_SCRIPT_URL=

# GA4 Measurement ID (e.g. G-XXXXXXXXXX). Must be prefixed NEXT_PUBLIC_ to reach the client.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Public site URL, used to resolve absolute OG/social preview image URLs.
# Set to the real Vercel/production URL once deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
