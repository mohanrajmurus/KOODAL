# Supabase project URL and service-role key, used server-side only to insert
# signups into the `signups` table (see CLAUDE.md for the table schema and
# setup SQL). The service role key bypasses Row Level Security — never
# prefix it NEXT_PUBLIC_ or otherwise let it reach the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared password gating the private /admin submissions-review page.
# Server-only — checked in app/api/admin/submissions/route.ts, never NEXT_PUBLIC_.
ADMIN_PASSWORD=

# GA4 Measurement ID (e.g. G-XXXXXXXXXX). Must be prefixed NEXT_PUBLIC_ to reach the client.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Public site URL, used to resolve absolute OG/social preview image URLs.
# Set to the real Vercel/production URL once deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
